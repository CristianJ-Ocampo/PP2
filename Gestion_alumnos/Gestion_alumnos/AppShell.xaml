<?xml version="1.0" encoding="utf-8" ?>

<Shell
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.AppShell"
    Title="Gestión de Alumnos">

    <TabBar>

        <ShellContent
            x:Name="EstudiantesTab"
            Title="Estudiantes"
            Route="Estudiantes" />

        <ShellContent
            x:Name="CalendarioTab"
            Title="Calendario"
            Route="Calendario" />

        <ShellContent
            x:Name="TrabajosTab"
            Title="Trabajos prácticos"
            Route="TrabajosPage" />

        <ShellContent
            x:Name="AsistenciaTab"
            Title="Asistencia"
            Route="Asistencia" />

        <ShellContent
            x:Name="EntregasTab"
            Title="Entregas"
            Route="EntregaPage" />

        <ShellContent
            x:Name="PanelTab"
            Title="Panel"
            Route="PanelPage" />

        <ShellContent
            x:Name="AdministracionTab"
            Title="Administración"
            Route="AdministracionPage" />

    </TabBar>

</Shell>