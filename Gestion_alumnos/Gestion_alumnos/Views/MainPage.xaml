<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.MainPage"
    BackgroundColor="#F3F6FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            HorizontalOptions="Center"
            MaximumWidthRequest="900">

            <!-- ENCABEZADO -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="Nómina de estudiantes"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Administración de estudiantes por comisión"
                    FontSize="14"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="TotalLabel"
                    Text="{Binding TotalTexto}"
                    FontSize="16"
                    TextColor="#2563A6"
                    Margin="0,8,0,0"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- FORMULARIO -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22"
                WidthRequest="650"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Cargar nuevo estudiante"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        Text="Apellido"
                        FontSize="14"
                        TextColor="#475569" />

                    <Entry
                        x:Name="ApellidoEntry"
                        Placeholder="Ingresar apellido"
                        Text="{Binding Apellido, Mode=TwoWay}"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <Label
                        Text="Nombre"
                        FontSize="14"
                        TextColor="#475569" />

                    <Entry
                        x:Name="NombreEntry"
                        Placeholder="Ingresar nombre"
                        Text="{Binding Nombre, Mode=TwoWay}"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <Label
                        Text="Legajo"
                        FontSize="14"
                        TextColor="#475569" />

                    <Entry
                        x:Name="LegajoEntry"
                        Placeholder="Ingresar legajo"
                        Keyboard="Numeric"
                        Text="{Binding Legajo, Mode=TwoWay}"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <Label
                        Text="Comisión"
                        FontSize="14"
                        TextColor="#475569" />

                    <Picker
                        x:Name="ComisionPicker"
                        Title="Seleccione una comisión"
                        ItemsSource="{Binding Comisiones}"
                        SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B"
                        TitleColor="#64748B" />

                    

                    <!-- BOTON AGREGAR -->
                    <Button
                        Text="AGREGAR ESTUDIANTE"
                        Command="{Binding AgregarEstudianteCommand}"
                        BackgroundColor="#16865D"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        WidthRequest="220"
                        HeightRequest="46"
                        HorizontalOptions="Center"
                        Margin="0,12,0,0" />

                </VerticalStackLayout>

            </Border>

            <!-- LISTADO DE ESTUDIANTES -->
            <VerticalStackLayout
                Spacing="12"
                WidthRequest="650"
                HorizontalOptions="Center">

                <Label
                    Text="Estudiantes cargados"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    Margin="0,12,0,0"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="MensajeVacioLabel"
                    Text="Esta comisión todavía no tiene estudiantes cargados."
                    IsVisible="{Binding MostrarMensajeVacio}"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <CollectionView
                    ItemsSource="{Binding EstudiantesVisibles}"
                    HeightRequest="350">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                BackgroundColor="White"
                                Stroke="#DEE6EF"
                                StrokeThickness="1"
                                Padding="15"
                                Margin="0,0,0,10">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="5">

                                    <Label
                                        Text="{Binding Apellido}"
                                        FontAttributes="Bold"
                                        FontSize="18"
                                        TextColor="#193B68" />

                                    <Label
                                        Text="{Binding Nombre}"
                                        FontSize="15"
                                        TextColor="#334155" />

                                    <HorizontalStackLayout Spacing="20">

                                        <HorizontalStackLayout Spacing="5">

                                            <Label
                                                Text="Legajo:"
                                                FontAttributes="Bold"
                                                TextColor="#64748B" />

                                            <Label
                                                Text="{Binding Legajo}"
                                                TextColor="#334155" />

                                        </HorizontalStackLayout>

                                        <HorizontalStackLayout Spacing="5">

                                            <Label
                                                Text="Comisión:"
                                                FontAttributes="Bold"
                                                TextColor="#64748B" />

                                            <Label
                                                Text="{Binding Comision}"
                                                TextColor="#334155" />

                                        </HorizontalStackLayout>

                                    </HorizontalStackLayout>

                                </VerticalStackLayout>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>