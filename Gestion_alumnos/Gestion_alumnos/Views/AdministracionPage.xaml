<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.AdministracionPage"
    Title="Administración"
    BackgroundColor="#F3F6FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            HorizontalOptions="Center"
            WidthRequest="700">

            <!-- ENCABEZADO -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="Administración del sistema"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Configuración y gestión de datos de la aplicación"
                    FontSize="14"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- CONFIGURACION DE RIESGO -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Configuración de riesgo académico"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        Text="Definí los porcentajes a partir de los cuales un estudiante tendrá riesgo medio o alto."
                        FontSize="14"
                        TextColor="#64748B" />

                    <!-- UMBRAL MEDIO -->
                    <Label
                        Text="Umbral de riesgo medio (%)"
                        FontSize="14"
                        TextColor="#475569"
                        Margin="0,8,0,0" />

                    <Entry
                        x:Name="UmbralMedioEntry"
                        Placeholder="Ejemplo: 20"
                        Keyboard="Numeric"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <!-- UMBRAL ALTO -->
                    <Label
                        Text="Umbral de riesgo alto (%)"
                        FontSize="14"
                        TextColor="#475569" />

                    <Entry
                        x:Name="UmbralAltoEntry"
                        Placeholder="Ejemplo: 40"
                        Keyboard="Numeric"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <!-- GUARDAR CONFIGURACION -->
                    <Button
                        Text="GUARDAR CONFIGURACIÓN"
                        Clicked="GuardarConfiguracion_Clicked"
                        BackgroundColor="#16865D"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        WidthRequest="260"
                        HeightRequest="46"
                        HorizontalOptions="Center"
                        Margin="0,12,0,0" />

                </VerticalStackLayout>

            </Border>

            <!-- LIMPIEZA DE DATOS -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Limpiar datos de prueba"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        Text="Esta operación elimina todos los estudiantes, clases, trabajos prácticos, asistencias y entregas registrados."
                        FontSize="14"
                        TextColor="#64748B" />

                    <!-- ADVERTENCIA -->
                    <Border
                        BackgroundColor="#FFF1F2"
                        Stroke="#FECACA"
                        StrokeThickness="1"
                        Padding="12">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>

                        <Label
                            Text="ATENCIÓN: Esta acción puede eliminar permanentemente los datos registrados. Utilizala únicamente cuando necesites reiniciar la información de prueba."
                            FontSize="14"
                            TextColor="#B91C1C" />

                    </Border>

                    <!-- ELIMINAR DATOS -->
                    <Button
                        Text="ELIMINAR TODOS LOS DATOS"
                        Clicked="LimpiarDatos_Clicked"
                        BackgroundColor="#C62828"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        WidthRequest="270"
                        HeightRequest="46"
                        HorizontalOptions="Center"
                        Margin="0,12,0,0" />

                </VerticalStackLayout>

            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>