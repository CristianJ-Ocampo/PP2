<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.AsistenciaPage"
    Title="Asistencia"
    BackgroundColor="#F3F6FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            HorizontalOptions="Center"
            MaximumWidthRequest="900">

            <!-- ENCABEZADO -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="Registro de asistencia"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Control de presentes y ausentes por clase"
                    FontSize="14"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- SELECCION DE CLASE -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22"
                WidthRequest="650"
                HorizontalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Seleccionar clase"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        Text="Comisión"
                        FontSize="14"
                        TextColor="#475569" />

                    <Picker
                        x:Name="ComisionPicker"
                        Title="Comisión"
                        ItemsSource="{Binding Comisiones}"
                        SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B"
                        TitleColor="#64748B" />

                    <Label
                        Text="Fecha de clase"
                        FontSize="14"
                        TextColor="#475569" />

                    <Picker
                        x:Name="ClasePicker"
                        Title="Seleccione una clase"
                        ItemsSource="{Binding ClasesDisponibles}"
                        SelectedItem="{Binding ClaseSeleccionada, Mode=TwoWay}"
                        ItemDisplayBinding="{Binding Fecha, StringFormat='{0:dd/MM/yyyy}'}"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B"
                        TitleColor="#64748B" />

                </VerticalStackLayout>

            </Border>

            <!-- LISTADO DE ASISTENCIA -->
            <VerticalStackLayout
                Spacing="12"
                WidthRequest="650"
                HorizontalOptions="Center">

                <Label
                    Text="Estudiantes de la comisión"
                    FontSize="22"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    Margin="0,12,0,0"
                    HorizontalTextAlignment="Center" />

                <Label
                    x:Name="MensajeVacioLabel"
                    Text="{Binding MensajeEstado}"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

                <!-- ENCABEZADO DE COLUMNAS -->
                <Grid
                    ColumnDefinitions="*,Auto"
                    ColumnSpacing="12"
                    Padding="15,5">

                    <Label
                        Grid.Column="0"
                        Text="Estudiante"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        Grid.Column="1"
                        Text="Presente"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                </Grid>

                <CollectionView
                    x:Name="ListaEstudiantes"
                    ItemsSource="{Binding EstudiantesAsistencia}"
                    HeightRequest="350">

                    <CollectionView.ItemTemplate>
                        <DataTemplate>

                            <Border
                                BackgroundColor="White"
                                Stroke="#DEE6EF"
                                StrokeThickness="1"
                                Padding="10"
                                Margin="0,0,0,8">

                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>

                                <Grid
                                    ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12"
                                    Padding="5">

                                    <Label
                                        Grid.Column="0"
                                        Text="{Binding NombreCompleto}"
                                        VerticalOptions="Center"
                                        FontSize="16"
                                        TextColor="#334155" />

                                    <CheckBox
                                        Grid.Column="1"
                                        IsChecked="{Binding Presente, Mode=TwoWay}"
                                        Color="#16865D"
                                        VerticalOptions="Center" />

                                </Grid>

                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- GUARDAR ASISTENCIA -->
                <Button
                    x:Name="GuardarButton"
                    Text="GUARDAR ASISTENCIA"
                    Command="{Binding GuardarAsistenciaCommand}"
                    IsEnabled="{Binding PuedeGuardar}"
                    BackgroundColor="#16865D"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    WidthRequest="240"
                    HeightRequest="46"
                    HorizontalOptions="Center"
                    Margin="0,12,0,0" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>