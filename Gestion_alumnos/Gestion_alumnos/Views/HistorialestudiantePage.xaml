<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.HistorialEstudiantePage"
    Title="Historial del estudiante"
    BackgroundColor="#F3F6FA">

    <ScrollView>
        <VerticalStackLayout
            Padding="25"
            Spacing="20"
            HorizontalOptions="Center"
            WidthRequest="700">

            <!-- ENCABEZADO -->
            <VerticalStackLayout
                Spacing="5"
                HorizontalOptions="Center">

                <Label
                    Text="Ficha del estudiante"
                    FontSize="30"
                    FontAttributes="Bold"
                    TextColor="#193B68"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Información académica y seguimiento individual"
                    FontSize="14"
                    TextColor="#64748B"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- DATOS PERSONALES -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Datos personales"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        x:Name="NombreEstudianteLabel"
                        Text="Estudiante:"
                        FontSize="17"
                        TextColor="#334155" />

                    <Label
                        x:Name="LegajoEstudianteLabel"
                        Text="Legajo:"
                        FontSize="15"
                        TextColor="#475569" />

                    <Label
                        x:Name="ComisionEstudianteLabel"
                        Text="Comisión:"
                        FontSize="15"
                        TextColor="#475569" />

                </VerticalStackLayout>

            </Border>

            <!-- HISTORIAL DE ASISTENCIAS -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Historial de asistencias"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <VerticalStackLayout
                        x:Name="ContenedorAsistencias"
                        Spacing="8" />

                </VerticalStackLayout>

            </Border>

            <!-- HISTORIAL DE TRABAJOS -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Historial de trabajos prácticos"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <VerticalStackLayout
                        x:Name="ContenedorTrabajos"
                        Spacing="8" />

                </VerticalStackLayout>

            </Border>

            <!-- RIESGO ACADEMICO -->
            <Border
                x:Name="RiesgoBorder"
                BackgroundColor="#EEF3F9"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Riesgo académico"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        x:Name="RiesgoEstudianteLabel"
                        Text="Riesgo: pendiente de cargar"
                        FontSize="16"
                        TextColor="#334155" />

                </VerticalStackLayout>

            </Border>

            <!-- REGISTRAR INTERVENCION -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Registrar intervención"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <Label
                        Text="Fecha del contacto"
                        FontSize="14"
                        TextColor="#475569" />

                    <DatePicker
                        x:Name="FechaIntervencionPicker"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <Label
                        Text="Medio de contacto"
                        FontSize="14"
                        TextColor="#475569" />

                    <Picker
                        x:Name="MedioContactoPicker"
                        Title="Seleccionar medio"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B"
                        TitleColor="#64748B">

                        <Picker.Items>
                            <x:String>Telefónico</x:String>
                            <x:String>Correo electrónico</x:String>
                            <x:String>Presencial</x:String>
                            <x:String>WhatsApp</x:String>
                            <x:String>Otro</x:String>
                        </Picker.Items>

                    </Picker>

                    <Label
                        Text="Motivo del contacto"
                        FontSize="14"
                        TextColor="#475569" />

                    <Editor
                        x:Name="MotivoIntervencionEditor"
                        Placeholder="Ej.: Inasistencias reiteradas"
                        HeightRequest="100"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <Label
                        Text="Resultado de la intervención"
                        FontSize="14"
                        TextColor="#475569" />

                    <Editor
                        x:Name="ResultadoIntervencionEditor"
                        Placeholder="Ej.: El estudiante se comprometió a regularizar su situación"
                        HeightRequest="100"
                        BackgroundColor="#F8FAFC"
                        TextColor="#1E293B" />

                    <Button
                        Text="GUARDAR INTERVENCIÓN"
                        BackgroundColor="#16865D"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        WidthRequest="260"
                        HeightRequest="46"
                        HorizontalOptions="Center"
                        Margin="0,12,0,0"
                        Clicked="GuardarIntervencion_Clicked" />

                </VerticalStackLayout>

            </Border>

            <!-- HISTORIAL DE INTERVENCIONES -->
            <Border
                BackgroundColor="White"
                Stroke="#DEE6EF"
                StrokeThickness="1"
                Padding="22">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="14">

                    <Label
                        Text="Historial de intervenciones"
                        FontSize="21"
                        FontAttributes="Bold"
                        TextColor="#193B68" />

                    <VerticalStackLayout
                        x:Name="ContenedorIntervenciones"
                        Spacing="10" />

                </VerticalStackLayout>

            </Border>

            <!-- VOLVER AL PANEL -->
            <Button
                Text="← VOLVER AL PANEL"
                Clicked="Volver_Clicked"
                BackgroundColor="#2563A6"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="8"
                WidthRequest="220"
                HeightRequest="46"
                HorizontalOptions="Center"
                Margin="0,10,0,20" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>