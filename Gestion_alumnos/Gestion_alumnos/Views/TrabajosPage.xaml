<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Gestion_alumnos.TrabajosPage"
    Title="Trabajos prácticos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label
                Text="Trabajos prácticos"
                FontSize="26"
                FontAttributes="Bold" />

            <Picker
                Title="Seleccione una comisión"
                SelectedItem="{Binding ComisionSeleccionada, Mode=TwoWay}">

                <Picker.Items>
                    <x:String>1°A</x:String>
                    <x:String>1°B</x:String>
                    <x:String>2°A</x:String>
                </Picker.Items>

            </Picker>

            <Label
                Text="Registrar trabajo práctico"
                FontSize="20"
                FontAttributes="Bold" />

            <Entry
                Placeholder="Nombre del trabajo práctico"
                Text="{Binding NombreTrabajo, Mode=TwoWay}" />

            <Label Text="Fecha de entrega" />

            <DatePicker
                Date="{Binding FechaEntrega, Mode=TwoWay}" />

            <Button
                Text="AGREGAR TRABAJO"
                Command="{Binding AgregarTrabajoCommand}" />

            <Label
                Text="Trabajos programados"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                Text="No hay trabajos registrados en esta comisión."
                IsVisible="{Binding MostrarTrabajosVacios}"
                TextColor="Gray" />

            <CollectionView
                ItemsSource="{Binding TrabajosVisibles}"
                HeightRequest="300">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <VerticalStackLayout Padding="10" Spacing="5">

                            <Label
                                Text="{Binding Nombre}"
                                FontAttributes="Bold"
                                FontSize="17" />

                            <Label
                                Text="{Binding FechaEntrega,
                                StringFormat='Entrega: {0:dd/MM/yyyy}'}" />

                            <Label
                                Text="{Binding Comision}" />

                        </VerticalStackLayout>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>